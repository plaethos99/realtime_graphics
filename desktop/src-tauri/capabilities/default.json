{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the overlay, settings and library windows",
  "windows": ["overlay", "settings", "library"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
