# Copy to proxy/.env and fill in. Without DEEPSEEK_API_KEY the proxy runs in mock mode.

# DeepSeek: vision + scene generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Thinking mode: better 3D and layouts, but ~10s slower to start talking. Off by default.
DEEPSEEK_THINKING=0
# Only used when thinking is on: low | high | max (model default is high)
DEEPSEEK_REASONING_EFFORT=
# Ask for a JSON object response. Falls back automatically if the API rejects it.
DEEPSEEK_JSON_MODE=1
DEEPSEEK_MAX_TOKENS=4000

# Groq: speech-to-text
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional ISO-639-1 code (e.g. en). Empty = auto-detect.
STT_LANGUAGE=

# edge-tts voice (GET /voices lists them)
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+8%

# Shared secret the apps send as X-App-Token (or ?token=). Set this before exposing the proxy.
APP_TOKEN=
# Comma-separated list, or * for any origin
CORS_ORIGINS=*
# Screenshots are downscaled to this width before going to the model
MAX_IMAGE_WIDTH=1280
# Force canned answers from shared/examples even when keys are set
MOCK=0

# Book library: where uploaded books, walkthroughs and progress are kept, and the reply size for walkthroughs.
# LIBRARY_DIR=proxy/data/library
# BOOK_MAX_TOKENS=8000
