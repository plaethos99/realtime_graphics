{
  "match": ["quadratic", "parabola", "roots", "solve"],
  "say": "x equals 3 or x equals minus 1. Factor it, then each bracket gives one root, where the parabola crosses the x axis.",
  "scene": {
    "title": "Solve $x^2 - 2x - 3 = 0$",
    "placement": { "x": 0.3, "y": 0.4 },
    "panel": {
      "type": "steps",
      "steps": [
        {
          "title": "Factor the left side",
          "text": "Find two numbers that multiply to $-3$ and add to $-2$: they are $-3$ and $1$. $$x^2 - 2x - 3 = (x-3)(x+1)$$"
        },
        {
          "title": "Set each factor to zero",
          "text": "$(x-3)(x+1) = 0$ means $x - 3 = 0$ or $x + 1 = 0$, so $x = 3$ or $x = -1$."
        },
        {
          "title": "Check on the graph",
          "text": "The roots are where $y = x^2 - 2x - 3$ crosses the $x$-axis. The vertex sits halfway between them, at $x = 1$.",
          "plot": {
            "x": [-3, 5],
            "items": [
              { "kind": "function", "id": "f", "fn": "x^2 - 2x - 3", "color": "blue", "label": "$y = x^2-2x-3$" },
              { "kind": "point", "at": [-1, 0], "label": "$x=-1$", "color": "red" },
              { "kind": "point", "at": [3, 0], "label": "$x=3$", "color": "red" },
              { "kind": "point", "on": "f", "x": 1, "label": "vertex $(1,-4)$", "color": "green" },
              { "kind": "vline", "x": 1, "label": "axis $x=1$" }
            ]
          }
        }
      ]
    }
  }
}
